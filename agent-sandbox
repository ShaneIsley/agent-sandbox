#!/bin/bash
# agent-sandbox — Podman container sandbox for agentic coding tools
#
# Symlink as <agent>-sandbox to avoid --agent flag:
#   ln -s agent-sandbox claude-sandbox
#   ln -s agent-sandbox pi-sandbox
#   claude-sandbox run ~/my-project
#   pi-sandbox shell ~/my-project
#
# Or use the base script with --agent:
#   agent-sandbox run ~/my-project --agent claude
#
# Each agent gets its own image (layered on a shared base) with only the
# domains and packages it needs. No agent sees permissions meant for another.
#
# Network modes (--network=locked|open, default locked):
#   locked  Default-deny allowlist; only per-agent domains reachable.
#   open    Public internet allowed; private networks denied at squid AND
#           nftables. IPv6 stack disabled in container.
#
# Depends on: sandbox-lib.sh (must be in the same directory)

set -uo pipefail

# ── Source shared library ────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="${SCRIPT_DIR}/sandbox-lib.sh"
if [[ ! -f "$LIB" ]]; then
    echo "ERROR: sandbox-lib.sh not found in ${SCRIPT_DIR}" >&2
    exit 1
fi
# shellcheck source=sandbox-lib.sh
source "$LIB"

# ── Config ──────────────────────────────────────────────────────────────────
IMAGE_BASE="agent-sandbox-base"
IMAGE_PREFIX="agent-sandbox"
IMAGE_TAG="latest"
CONTAINER_PREFIX="sandbox"
BUILD_DIR="${SCRIPT_DIR}/agent-sandbox-build"

# ── Agent Profiles ──────────────────────────────────────────────────────────

agent_get() {
    local agent="$1" field="$2"
    case "${agent}::${field}" in
        claude::package)     echo "@anthropic-ai/claude-code@latest" ;;
        claude::command)     echo "claude" ;;
        claude::config_dir)  echo "/home/agent/.claude" ;;
        claude::config_file) echo "/home/agent/.claude.json" ;;
        claude::volume)      echo "claude-sandbox-auth" ;;
        claude::env_unset)   echo "ANTHROPIC_API_KEY" ;;
        claude::image)       echo "${IMAGE_PREFIX}-claude:${IMAGE_TAG}" ;;
        claude::ports)       echo "" ;;

        pi::package)         echo "@mariozechner/pi-coding-agent@latest" ;;
        pi::command)         echo "pi" ;;
        pi::config_dir)      echo "/home/agent/.pi" ;;
        pi::config_file)     echo "" ;;
        pi::volume)          echo "pi-sandbox-auth" ;;
        pi::env_unset)       echo "" ;;
        pi::image)           echo "${IMAGE_PREFIX}-pi:${IMAGE_TAG}" ;;
        pi::ports)           echo "8085" ;;

        gemini::package)     echo "@google/gemini-cli@latest" ;;
        gemini::command)     echo "gemini" ;;
        gemini::config_dir)  echo "/home/agent/.gemini" ;;
        gemini::config_file) echo "" ;;
        gemini::volume)      echo "gemini-sandbox-auth" ;;
        gemini::env_unset)   echo "" ;;
        gemini::image)       echo "${IMAGE_PREFIX}-gemini:${IMAGE_TAG}" ;;
        gemini::ports)       echo "8085" ;;

        *)
            err "Unknown agent field: ${agent}::${field}"
            return 1
            ;;
    esac
}

KNOWN_AGENTS="claude pi gemini"
KNOWN_NETWORKS="locked open"

validate_agent() {
    local agent="$1"
    for a in $KNOWN_AGENTS; do
        [ "$a" = "$agent" ] && return 0
    done
    err "Unknown agent: $agent (known: $KNOWN_AGENTS)"
    exit 1
}

validate_network() {
    local mode="$1"
    for n in $KNOWN_NETWORKS; do
        [ "$n" = "$mode" ] && return 0
    done
    err "Invalid --network: $mode (must be one of: $KNOWN_NETWORKS)"
    exit 1
}

# ── Detect agent from script name ───────────────────────────────────────────
DETECTED_AGENT=""
_invoked_as="$(basename "$0" .sh)"
for _a in $KNOWN_AGENTS; do
    if [ "$_invoked_as" = "${_a}-sandbox" ]; then
        DETECTED_AGENT="$_a"
        break
    fi
done
unset _invoked_as _a

# ── Agent-specific helpers ──────────────────────────────────────────────────

parse_agent_flag() {
    AGENT=""
    NETWORK="locked"
    REMAINING_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --agent)
                if [ -z "${2:-}" ]; then
                    err "--agent requires a value ($KNOWN_AGENTS)"
                    exit 1
                fi
                AGENT="$2"
                shift 2
                ;;
            --agent=*)
                AGENT="${1#--agent=}"
                shift
                ;;
            --network)
                if [ -z "${2:-}" ]; then
                    err "--network requires a value ($KNOWN_NETWORKS)"
                    exit 1
                fi
                NETWORK="$2"
                shift 2
                ;;
            --network=*)
                NETWORK="${1#--network=}"
                shift
                ;;
            *)
                REMAINING_ARGS+=("$1")
                shift
                ;;
        esac
    done
    if [ -z "$AGENT" ]; then
        AGENT="$DETECTED_AGENT"
    fi
    if [ -z "$AGENT" ]; then
        err "Cannot determine agent. Use --agent NAME or invoke as <agent>-sandbox."
        exit 1
    fi
    validate_agent "$AGENT"
    validate_network "$NETWORK"
}

