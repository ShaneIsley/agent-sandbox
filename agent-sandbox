# ── Commands ────────────────────────────────────────────────────────────────

cmd_setup() {
    require_podman
    write_build_context

    # Build base image (from sandbox-lib.sh)
    if ! build_base_image "$BUILD_DIR" "$IMAGE_BASE" "$IMAGE_TAG"; then
        exit 1
    fi

    # Build per-agent images
    for a in $KNOWN_AGENTS; do
        local img
        img="$(agent_get "$a" image)"
        log "Building ${a} image..."
        if ! podman build -t "$img" "${BUILD_DIR}/${a}"; then
            err "${a} image build failed"
            exit 1
        fi
        ok "Agent image: ${img}"
    done

    # Create per-agent auth volumes
    for a in $KNOWN_AGENTS; do
        local vol
        vol="$(agent_get "$a" volume)"
        volume_ensure "$vol"
    done

    # Create per-agent symlinks next to the script
    local script_path
    script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    for a in $KNOWN_AGENTS; do
        local link="${SCRIPT_DIR}/${a}-sandbox"
        if [ ! -e "$link" ]; then
            ln -sf "$script_path" "$link"
            ok "Symlink created: ${a}-sandbox → $(basename "$script_path")"
        else
            ok "Symlink exists: ${a}-sandbox"
        fi
    done

    echo ""
    ok "Setup complete. Usage:"
    for a in $KNOWN_AGENTS; do
        echo "  ${a}-sandbox run <project-path>   [--network locked|open]"
        echo "  ${a}-sandbox shell <project-path> [--network locked|open]"
    done
    echo ""
    echo "  $(basename "$0") status"
    echo "  $(basename "$0") teardown <name|path>"
    echo "  $(basename "$0") teardown all"
}

cmd_update() {
    local target="${1:-}"
    require_podman

    if [ -z "$target" ]; then
        err "Usage: $(basename "$0") update <agent|all>"
        echo "  Agents: $KNOWN_AGENTS"
        exit 1
    fi

    local agents_to_update
    if [ "$target" = "all" ]; then
        agents_to_update="$KNOWN_AGENTS"
    else
        validate_agent "$target"
        agents_to_update="$target"
    fi

    if ! image_exists "${IMAGE_BASE}:${IMAGE_TAG}"; then
        err "Base image not found. Run: $(basename "$0") setup"
        exit 1
    fi

    write_build_context

    for a in $agents_to_update; do
        local img
        img="$(agent_get "$a" image)"
        log "Rebuilding ${a} image (--no-cache)..."
        if ! podman build --no-cache -t "$img" "${BUILD_DIR}/${a}"; then
            err "${a} image rebuild failed"
            exit 1
        fi
        ok "Updated: ${img}"

        local running
        running=$(podman ps --filter "ancestor=${img}" --filter "status=running" --format '{{.Names}}' 2>/dev/null)
        if [ -n "$running" ]; then
            warn "Running containers still use the old image — restart to pick up the update:"
            echo "$running" | while read -r ctr; do
                echo "  $ctr"
            done
        fi
    done
}

cmd_teardown() {
    local target="${1:-}"
    require_podman

    if [ -z "$target" ]; then
        err "Specify a project path or 'all'"
        echo "Usage: $(basename "$0") teardown <project-path>   # remove containers for project"
        echo "       $(basename "$0") teardown all              # remove everything"
        echo ""
        echo "Containers:"
        list_containers_by_prefix "$CONTAINER_PREFIX" | while IFS=$'\t' read -r name state created; do
            echo "  $name ($state)"
        done
        exit 1
    fi

    if [ "$target" = "all" ]; then
        log "Tearing down all sandbox resources..."

        local containers
        containers=$(podman ps -a --filter "name=^${CONTAINER_PREFIX}-" --format '{{.Names}}' 2>/dev/null)
        if [ -n "$containers" ]; then
            echo "$containers" | xargs podman rm -f 2>/dev/null
            ok "Containers removed: $(echo "$containers" | tr '\n' ' ')"
        fi

        # Legacy containers
        local legacy
        legacy=$(podman ps -a --filter "name=^claude-sandbox-" --format '{{.Names}}' 2>/dev/null)
        if [ -n "$legacy" ]; then
            echo "$legacy" | xargs podman rm -f 2>/dev/null
            ok "Legacy containers removed: $(echo "$legacy" | tr '\n' ' ')"
        fi

        # Agent images
        for a in $KNOWN_AGENTS; do
            local img
            img="$(agent_get "$a" image)"
            if image_exists "$img"; then
                podman rmi "$img" 2>/dev/null
                ok "Image removed: ${img}"
            fi
        done

        # Base image
        if image_exists "${IMAGE_BASE}:${IMAGE_TAG}"; then
            podman rmi "${IMAGE_BASE}:${IMAGE_TAG}" 2>/dev/null
            ok "Base image removed"
        fi

        # Legacy image
        if image_exists "claude-sandbox:latest"; then
            podman rmi "claude-sandbox:latest" 2>/dev/null
            ok "Legacy image removed"
        fi

        # Per-agent auth volumes
        for a in $KNOWN_AGENTS; do
            local vol
            vol="$(agent_get "$a" volume)"
            if volume_exists "$vol"; then
                echo -n "Remove ${a} auth volume '${vol}' (you'll need to re-authenticate)? [y/N] "
                read -r answer
                if [[ "$answer" =~ ^[Yy]$ ]]; then
                    volume_remove "$vol"
                else
                    warn "Auth volume kept: ${vol}"
                fi
            fi
        done

        if [ -d "$BUILD_DIR" ]; then
            rm -rf "$BUILD_DIR"
            ok "Build context removed"
        fi

        # Remove agent symlinks
        for a in $KNOWN_AGENTS; do
            local link="${SCRIPT_DIR}/${a}-sandbox"
            if [ -L "$link" ]; then
                rm "$link"
                ok "Symlink removed: ${a}-sandbox"
            fi
        done

        ok "Full teardown complete"
    else
        local project_name
        if [ -d "$target" ]; then
            project_name="$(basename "$(cd "$target" && pwd)")"
        else
            project_name="$(basename "$target")"
        fi

        local found=0
        for a in $KNOWN_AGENTS; do
            local ctr_name
            ctr_name="$(container_name_for "$CONTAINER_PREFIX" "$a" "$project_name")"
            if container_exists "$ctr_name"; then
                podman rm -f "$ctr_name" 2>/dev/null
                ok "Container removed: ${ctr_name}"
                found=1
            fi
        done

        # Legacy naming
        local legacy_name
        legacy_name="claude-sandbox-$(sanitize_name "$project_name")"
        if container_exists "$legacy_name"; then
            podman rm -f "$legacy_name" 2>/dev/null
            ok "Container removed (legacy): ${legacy_name}"
            found=1
        fi

        if [ "$found" -eq 0 ]; then
            warn "No containers found for project: ${project_name}"
        fi
    fi
}

cmd_status() {
    require_podman

    echo "=== Agent Sandbox ==="
    echo ""

    if image_exists "${IMAGE_BASE}:${IMAGE_TAG}"; then
        ok "Base image: ${IMAGE_BASE}:${IMAGE_TAG}"
    else
        warn "Base image: not built"
    fi

    for a in $KNOWN_AGENTS; do
        local img vol
        img="$(agent_get "$a" image)"
        vol="$(agent_get "$a" volume)"

        if image_exists "$img"; then
            local img_info
            img_info=$(podman image inspect "$img" --format '{{.Created}}  {{.Size}}' 2>/dev/null)
            ok "Image [${a}]: ${img}  (${img_info})"
        else
            warn "Image [${a}]: not built"
        fi

        if volume_exists "$vol"; then
            ok "Volume [${a}]: ${vol}"
        else
            warn "Volume [${a}]: not created"
        fi
    done

    local containers
    containers=$(list_containers_by_prefix "$CONTAINER_PREFIX")
    if [ -n "$containers" ]; then
        echo "   Containers:"
        echo "$containers" | while IFS=$'\t' read -r name state created; do
            # SANDBOX_NETWORK is set by run_container starting in v1.1; older
            # containers (or anything started outside this CLI) won't have it.
            local mode
            mode=$(podman inspect "$name" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
                   | grep '^SANDBOX_NETWORK=' | cut -d= -f2)
            if [ "$state" = "running" ]; then
                ok "  $name (mode: ${mode:-unknown}, $state, $created)"
            else
                warn "  $name (mode: ${mode:-unknown}, $state, $created)"
            fi
        done
    else
        echo "   Containers: none"
    fi

    echo ""
    podman machine info 2>/dev/null | head -5 || warn "Podman machine not reachable"
}

run_container() {
    local agent="$1" ctr_name="$2" project_path="$3" project_name="$4" cmd="$5"

    # Refuse on existing container — do not silently destroy in-flight work.
    # User makes the choice: resume via `podman exec`, or `agent-sandbox teardown`.
    if container_exists "$ctr_name"; then
        local existing_status existing_image existing_network
        existing_status=$(podman ps -a --filter "name=^${ctr_name}\$" --format '{{.Status}}' 2>/dev/null | head -1)
        existing_image=$(podman inspect "$ctr_name" --format '{{.ImageName}}' 2>/dev/null)
        existing_network=$(podman inspect "$ctr_name" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
                           | grep '^SANDBOX_NETWORK=' | cut -d= -f2)
        err "A sandbox already exists for this project."
        {
            echo "         container: $ctr_name"
            echo "         status:    ${existing_status:-unknown}"
            echo "         image:     ${existing_image:-unknown}"
            echo "         network:   ${existing_network:-locked}"
            echo ""
            echo "       To resume working in it (open a second shell into the running container):"
            echo "         podman exec -it $ctr_name bash"
            echo ""
            echo "       To remove it and start fresh:"
            echo "         $(basename "$0") teardown $project_name"
            echo ""
            echo "       Exiting without changes."
        } >&2
        exit 1
    fi

    local agent_image agent_volume agent_config_dir agent_cmd agent_ports
    agent_image="$(agent_get "$agent" image)"
    agent_volume="$(agent_get "$agent" volume)"
    agent_config_dir="$(agent_get "$agent" config_dir)"
    agent_cmd="$(agent_get "$agent" command)"
    agent_ports="$(agent_get "$agent" ports)"

    local exec_cmd="$cmd"
    if [ "$cmd" = "__agent__" ]; then
        exec_cmd="$agent_cmd"
    fi

    # Random host port — lets multiple pi/gemini sandboxes coexist.
    # Discover the assigned port with: podman port <container>
    local port_args=()
    if [ -n "$agent_ports" ]; then
        for p in $agent_ports; do
            port_args+=(-p "${p}")
        done
    fi

    # In open mode, disable IPv6 in the container via kernel-namespaced sysctls.
    # Defense in depth: even though squid-open and nftables-open both block
    # IPv6 destinations, killing the stack outright is simpler than maintaining
    # parallel ip6 ACL sets that handle SLAAC, ULA, link-local correctly.
    local sysctl_args=()
    if [ "${NETWORK:-locked}" = "open" ]; then
        sysctl_args+=(--sysctl "net.ipv6.conf.all.disable_ipv6=1")
        sysctl_args+=(--sysctl "net.ipv6.conf.default.disable_ipv6=1")
    fi

    # SANDBOX_PROJECT is the canonical name (since v1.1). CLAUDE_PROJECT is
    # kept as a compat alias for one release for any in-container scripts that
    # still read the old name; planned for removal in v1.2.
    # shellcheck disable=SC2086  # word-splitting on $exec_cmd is intentional: it may be a multi-token command
    podman run --rm -it \
        --name "$ctr_name" \
        --hostname "sandbox-${agent}-${project_name}" \
        --cap-add=NET_ADMIN \
        "${port_args[@]+"${port_args[@]}"}" \
        "${sysctl_args[@]+"${sysctl_args[@]}"}" \
        -v "${project_path}:/workspace:rw" \
        -v "${agent_volume}:${agent_config_dir}:rw" \
        -e "SANDBOX_PROJECT=${project_name}" \
        -e "CLAUDE_PROJECT=${project_name}" \
        -e "SANDBOX_NETWORK=${NETWORK:-locked}" \
        "$agent_image" \
        $exec_cmd
}

cmd_run() {
    local agent="$1" project_path="$2"
    require_podman

    local img
    img="$(agent_get "$agent" image)"
    if ! image_exists "$img"; then
        err "Image not built for ${agent}. Run: $(basename "$0") setup"
        exit 1
    fi

    project_path="$(resolve_project_path "$project_path")"
    local project_name
    project_name="$(basename "$project_path")"
    local ctr_name
    ctr_name="$(container_name_for "$CONTAINER_PREFIX" "$agent" "$project_name")"

    log "Starting ${agent} (${NETWORK:-locked}): ${project_name} [${ctr_name}]"
    run_container "$agent" "$ctr_name" "$project_path" "$project_name" "__agent__"
}

cmd_shell() {
    local agent="$1" project_path="$2"
    require_podman

    local img
    img="$(agent_get "$agent" image)"
    if ! image_exists "$img"; then
        err "Image not built for ${agent}. Run: $(basename "$0") setup"
        exit 1
    fi

    project_path="$(resolve_project_path "$project_path")"
    local project_name
    project_name="$(basename "$project_path")"
    local ctr_name
    ctr_name="$(container_name_for "$CONTAINER_PREFIX" "$agent" "$project_name")"

    log "Opening shell (${agent}, ${NETWORK:-locked}): ${project_name} [${ctr_name}]"
    run_container "$agent" "$ctr_name" "$project_path" "$project_name" "/bin/bash"
}

# ── Main ────────────────────────────────────────────────────────────────────

usage() {
    cat << EOF
Usage: <agent>-sandbox <command> [options]

Symlinks (created by setup):
$(for a in $KNOWN_AGENTS; do
    echo "  ${a}-sandbox run   <project-path> [--network locked|open]"
    echo "  ${a}-sandbox shell <project-path> [--network locked|open]"
done)

Network modes:
  locked  (default)  Default-deny allowlist; only per-agent domains reachable
  open               Public internet allowed; private networks denied at squid
                     AND nftables; IPv6 disabled in container

Management:
  $(basename "$0") setup                       Build all images and create volumes + symlinks
  $(basename "$0") update <agent|all>          Rebuild agent image(s) with latest package
  $(basename "$0") status                      Show sandbox component status
  $(basename "$0") teardown <name|path>        Remove containers for a project
  $(basename "$0") teardown all                Remove everything

Or use --agent directly:
  $(basename "$0") run   <project-path> --agent NAME [--network MODE]
  $(basename "$0") shell <project-path> --agent NAME [--network MODE]
EOF
}

case "${1:-}" in
    setup)
        cmd_setup
        ;;
    update)
        cmd_update "${2:-}"
        ;;
    teardown)
        cmd_teardown "${2:-}"
        ;;
    status)
        cmd_status
        ;;
    run)
        shift
        parse_agent_flag "$@"
        if [ ${#REMAINING_ARGS[@]} -eq 0 ]; then
            err "Missing project path"
            echo "Usage: $(basename "$0") run <project-path>"
            exit 1
        fi
        cmd_run "$AGENT" "${REMAINING_ARGS[0]}"
        ;;
    shell)
        shift
        parse_agent_flag "$@"
        if [ ${#REMAINING_ARGS[@]} -eq 0 ]; then
            err "Missing project path"
            echo "Usage: $(basename "$0") shell <project-path>"
            exit 1
        fi
        cmd_shell "$AGENT" "${REMAINING_ARGS[0]}"
        ;;
    *)
        usage
        exit 1
        ;;
esac
