# Generated by `agent-sandbox setup` — Dockerfile build context for the
# base image and per-agent images. Regenerated on every setup/update.
agent-sandbox-build/

# Per-agent symlinks to agent-sandbox, created by `setup`. They point at
# agent-sandbox in this same directory; rebuilding setup recreates them.
claude-sandbox
pi-sandbox
gemini-sandbox
# Test/scratch directories — stray artifacts from interactive shell sessions
test-instance-dir/
# OS / editor noise
.DS_Store
*.swp
*.swo
*~
HANDOFF.md
IMPROVEMENTS.md
